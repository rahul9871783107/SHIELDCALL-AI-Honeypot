# ========================================
# SHIELDCALL Environment Configuration
# ========================================
# IMPORTANT: Copy this file to .env and add real values
# NEVER commit .env to git!

# ========================================
# API Configuration
# ========================================
API_KEY=hackathon-secret-key-2026
PORT=8000
HOST=0.0.0.0

# ========================================
# AI API Keys (SECURITY SENSITIVE!)
# ========================================

# REQUIRED: Anthropic Claude API Key
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-actual-anthropic-key-here

# RECOMMENDED: Google Gemini API Key (saves 60% cost!)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-gemini-key-here

# OPTIONAL: OpenAI API Key (for audio transcription)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ========================================
# GUVI Hackathon Configuration
# ========================================
GUVI_CALLBACK_URL=https://hackathon.guvi.in/api/updateHoneyPotFinalResult

# ========================================
# Application Settings
# ========================================
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production

# ========================================
# Scam Detection Settings
# ========================================
SCAM_CONFIDENCE_THRESHOLD=0.65
MAX_CONVERSATION_TURNS=25
SESSION_TIMEOUT_MINUTES=30

# ========================================
# Hybrid AI Settings
# ========================================
USE_HYBRID_AI=true
WHISPER_MODEL=whisper-1
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=500
GEMINI_TEMPERATURE=0.3
CLAUDE_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7

# ========================================
# Intelligence Extraction Settings
# ========================================
AUTO_CALLBACK_AFTER_TURNS=15
MIN_INTELLIGENCE_FOR_CALLBACK=2
